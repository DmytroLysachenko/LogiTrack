{
  "ConnectionStrings": {
    "LogiTrackDatabase": "Data Source=logitrack.db"
  },
  "Jwt": {
    "Issuer": "LogiTrack",
    "Audience": "LogiTrackClient",
    "Key": "dev-only-logitrack-secret-key-change-before-production",
    "ExpiryMinutes": 60
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
